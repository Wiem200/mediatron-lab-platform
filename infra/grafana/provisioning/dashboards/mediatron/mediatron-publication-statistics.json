          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mediatron-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  classification,\n  COUNT(*)::double precision AS publications\nFROM (\n  SELECT CASE\n    WHEN p.type = 'CONFERENCE_A' THEN 'A'\n    WHEN p.type = 'CONFERENCE_B' THEN 'B'\n    WHEN p.type = 'CONFERENCE_C' THEN 'C'\n    WHEN COALESCE(p.indexation, '') ILIKE '%national%'\n      OR COALESCE(p.source, '') ILIKE '%national%'\n      OR p.type = 'WORKSHOP'\n    THEN 'National'\n    ELSE NULL\n  END AS classification\n  FROM publications p\n  WHERE p.status IN (${publication_status:sqlstring})\n) conference_breakdown\nWHERE classification IS NOT NULL\nGROUP BY classification\nORDER BY CASE classification WHEN 'A' THEN 1 WHEN 'B' THEN 2 WHEN 'C' THEN 3 ELSE 4 END;",
          "refId": "A"
        }
      ],
      "title": "Conference Classification Breakdown",
      "type": "barchart"
    },
