          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  make_date(p.publication_year, 1, 1) AS \"time\",\n  TRIM(CONCAT(m.first_name, ' ', m.last_name)) AS metric,\n  COUNT(*)::double precision AS value\nFROM publications p\nJOIN members_publications mp ON mp.publication_id = p.id\nJOIN members m ON m.id = mp.member_id\nWHERE p.publication_year IS NOT NULL\n  AND p.status IN (${publication_status:sqlstring})\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "Evolution By Member",
      "type": "timeseries"
