          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  make_date(p.publication_year, 1, 1) AS \"time\",\n  COUNT(*)::double precision AS \"Publications\"\nFROM publications p\nWHERE p.publication_year IS NOT NULL\n  AND p.status IN (${publication_status:sqlstring})\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Publication Count Per Year",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "mediatron-postgres"
      },
      "description": "Share of journal publications versus conference publications in the filtered publication set.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "displayLabels": [
          "name",
          "percent",
          "value"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "pie",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mediatron-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  category,\n  COUNT(*)::double precision AS publications\nFROM (\n  SELECT CASE\n    WHEN p.type = 'JOURNAL' THEN 'Journal'\n    WHEN p.type IN ('CONFERENCE_A', 'CONFERENCE_B', 'CONFERENCE_C')\n      OR COALESCE(p.indexation, '') ILIKE '%national%'\n      OR COALESCE(p.source, '') ILIKE '%national%'\n      OR p.type = 'WORKSHOP'\n    THEN 'Conference'\n    ELSE NULL\n  END AS category\n  FROM publications p\n  WHERE p.status IN (${publication_status:sqlstring})\n) distribution\nWHERE category IS NOT NULL\nGROUP BY category\nORDER BY category;",
          "refId": "A"
        }
      ],
      "title": "Journal Vs Conference Distribution",
      "type": "piechart"
    },
    {
